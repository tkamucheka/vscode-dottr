{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["@{", "}"]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "@{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!#).*\\bdo\\s*(#.*)?$|^\\s*else\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(end|else)\\b"
  }
}
